{
  "name": "marysoll-platform",
  "version": "16.1.33",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --webpack --port 3006",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:engines": "npm test --workspaces --if-present",
    "migrate:subscription-index": "node --env-file=.env.local scripts/fix-subscription-index.mjs",
    "fixtures:theme": "node --env-file=.env.local scripts/make-theme-fixtures.mjs",
    "backfill:identity": "echo 'Deprecated — backfill-user-identity script removed'",
    "test:watch": "vitest",
    "seed:theme9": "node --env-file=.env.local scripts/seeds/seed-expert-editorial.mts",
    "normalize:theme9": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/normalize-theme9-section-state.mts",
    "push:subscriptions": "node --env-file=.env.local scripts/prune-push-subscriptions.mjs",
    "copy:tenants": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/copy-tenants-to-staging.mts",
    "backfill:education-snapshot": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/backfill-education-published-snapshot.mts",
    "backfill:education-access": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/backfill-education-access-mode.mts",
    "backfill:group-price": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/backfill-group-package-price.mts",
    "cleanup:stale-group-items": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/cleanup-stale-group-items.mts"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@paddle/paddle-js": "^1.6.4",
    "@tanstack/react-query": "^5.90.6",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.25",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "mammoth": "^1.12.2",
    "mongoose": "^8.19.3",
    "next": "^16.1.6",
    "openai": "^6.33.0",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.4.1",
    "resend": "^6.6.0",
    "ts-node": "^10.9.2",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "fallow": "^3.17.0",
    "mongodb-memory-server": "^10.4.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "bn.js": "^5.2.3",
    "ajv": "^6.12.6",
    "cross-spawn": "^7.0.6",
    "glob": "^10.4.5"
  }
}
