{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/Accordion/**",
              "components/general/AnimatedCtaContent/**",
              "components/general/AnimatedCtaLink/**",
              "components/general/ArrowLink/**",
              "components/general/BackToSiteMenuItem/**",
              "components/general/ButtonLink/**",
              "components/general/Chip/**",
              "components/general/Eyebrow/**",
              "components/general/MonogramAvatar/**",
              "components/general/SectionHeading/**",
              "components/motion/Reveal/**",
              "components/motion/StickyBar/**",
              "components/panel/ConfirmModal/**",
              "components/panel/EmptyDashedCard/**",
              "components/panel/ProgressBar/**",
              "components/panel/StatCard/**",
              "components/panel/StatusBadge/**",
              "components/panel/TabPills/**",
              "components/panel/Toggle/**",
              "components/shared/BackToSiteButton/**",
              "components/shared/JsonLd/**",
              "components/shared/LogoutAvatarMenu/**",
              "components/shared/PageHero/**",
              "components/shared/ReasonCard/**",
              "components/shared/ResourceCard/**",
              "components/shared/TherapistCard/**",
              "components/shared/TherapistRow/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Sans|Newsreader))/i]",
        "message": "Font not provided by the design system. Available: Instrument Sans, Newsreader."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
