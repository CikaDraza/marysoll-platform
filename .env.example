# ─── DATABASE ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://...

# ─── AUTH ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars

# ─── APP URLS ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://marysoll.com
NEXT_PUBLIC_ADMIN_URL=https://admin.marysoll.com
NEXT_PUBLIC_SUPERADMIN_URL=https://superadmin.marysoll.com
NEXT_PUBLIC_CLIENT_URL=https://app.marysoll.com

# ─── CLOUDINARY ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── EMAIL (RESEND) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@marysoll.com
# Platform logo shown in owner emails (verification, welcome). Leave empty to show gradient symbol.
PLATFORM_LOGO_URL=https://marysoll.com/logo.png

# ─── AI - LANDING CMS AGENTS ─────────────────────────────────────────────────
# Agent: Landing CMS SEO analysis (seoAgentLandingTheme)
API_KEY_SEO_LADNING_THEME=sk-...

# Agent: Landing CMS content auto-fix (landingContentAgent)
API_KEY_LANDING_CONTENT=sk-...

# ─── AI - THREE SEPARATE DEEPSEEK AGENTS ────────────────────────────────────
# Agent 1: Client-facing chat (booking, prices, auth blocks, salon info)
DEEPSEEK_API_KEY_CHAT=sk-...

# Agent 2: Landing page generation + SEO (newsletter landing pages, CMS blocks)
DEEPSEEK_API_KEY_LANDING=sk-...

# Agent 3: Image prompt generation (generates prompts, actual rendering via Gemini)
DEEPSEEK_API_KEY_IMAGE=sk-...

# ─── AI - GOOGLE GEMINI (image generation only) ───────────────────────────────
# NOTE: DeepSeek does not support image generation.
# Gemini is kept exclusively for generating images (generate-image endpoint).
GEMINI_API_KEY=AIza...

# ─── WEB PUSH (VAPID) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:admin@marysoll.com

# ─── LEMON SQUEEZY (payments) ─────────────────────────────────────────────────
LEMONSQUEEZY_API_KEY=...
LEMONSQUEEZY_WEBHOOK_SECRET=...
LEMONSQUEEZY_STORE_ID=...

# ─── SUPER ADMIN ──────────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=superadmin@marysoll.com

# ─── CRON (Vercel) ────────────────────────────────────────────────────────────
CRON_SECRET=your_cron_secret

# ─── LOCAL DEV ONLY ────────────────────────────────────────────────────────────
# Simulate different domain types on localhost:
# DEV_DOMAIN_TYPE=marketing   (default, shows marysoll.com landing)
# DEV_DOMAIN_TYPE=admin       (shows admin panel)
# DEV_DOMAIN_TYPE=superadmin  (shows superadmin panel)
# DEV_DOMAIN_TYPE=client      (shows salon client page)
# DEV_TENANT_SLUG=nail-studio (which salon to show when DEV_DOMAIN_TYPE=client)
DEV_DOMAIN_TYPE=marketing

👉 
auto-enforced Mongoose plugin (tenantId injection)
global query wrapper da nikad ne zaboraviš tenantId
# External Platform API
PLATFORM_API_URL=https://api.marysoll.com

# ─── MARKETPLACE CACHE INVALIDATION (webhook: platform → booking.marysoll.com) ────
# When a superadmin toggles a salon's marketplace visibility or city popularity,
# the platform POSTs to the booking app so it drops its city catalog cache
# immediately. Both values must be set for the webhook to fire (otherwise the
# booking app's 2-min TTL is the only fallback). The secret must match
# BOOKING_REVALIDATE_SECRET in the booking app.
BOOKING_REVALIDATE_URL=https://booking.marysoll.com/api/revalidate-marketplace
BOOKING_REVALIDATE_SECRET=change-me-shared-secret

